{
  "name": "loadout",
  "version": "0.1.1",
  "private": true,
  "description": "A mod manager for Claude Code skills.",
  "type": "module",
  "main": "out/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm --prefix engine test",
    "dist": "npm run build && electron-builder --win --x64",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "loadout-engine": "file:./engine"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.10.2",
    "electron": "44.4.5",
    "electron-builder": "^26.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Loadout",
  "build": {
    "appId": "com.loadout.app",
    "productName": "Loadout",
    "copyright": "Loadout",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "catalog/catalog.json",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loadout",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Loadout-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NeekBot5000",
        "repo": "loadout",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NeekBot5000/loadout.git"
  },
  "homepage": "https://github.com/NeekBot5000/loadout",
  "license": "MIT"
}
